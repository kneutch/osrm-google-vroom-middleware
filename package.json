{
    "name": "osrm-google-vroom-middleware",
    "version": "1.0.0",
    "description": "Middleware for OSRM, Google Maps, and VROOM integration",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "dev": "nodemon src/index.js",
        "debug": "node --inspect=0.0.0.0:9229 src/index.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:mock": "jest __tests__/mock-servers.test.js",
        "test:middleware": "jest __tests__/middleware.test.js",
        "test:setup": "./scripts/test-setup.sh",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f"
    },
    "keywords": [
        "osrm",
        "google-maps",
        "vroom",
        "routing",
        "optimization",
        "middleware"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "axios": "^1.6.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0"
    },
    "devDependencies": {
        "nodemon": "^3.0.1",
        "eslint": "^8.52.0",
        "jest": "^29.7.0",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}